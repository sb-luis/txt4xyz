{
	admin off
	persist_config off
	auto_https off # railway terminates TLS; enabling this breaks its proxy
	log {
		format console
	}
	servers {
		trusted_proxies static private_ranges
	}
}

:{$PORT} {
	log {
		format console
	}

	# WebSocket connection — proxied directly, no prefix to strip
	reverse_proxy /ws {$BACKEND_ENDPOINT} {
		header_up X-Real-IP {http.request.remote.host}
	}

	# Everything else goes to the frontend's static file server
	reverse_proxy /* {$FRONTEND_ENDPOINT}
}
